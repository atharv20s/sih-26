# Copy to .env and fill in real values. Never commit .env itself.

# Postgres connection string (SQLAlchemy + psycopg v3 driver prefix).
# For Neon: postgresql+psycopg://<user>:<password>@<host>/<db>?sslmode=require&channel_binding=require
DATABASE_URL=postgresql+psycopg://user:password@localhost/prahari

# JWT signing secret for auth cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# HMAC secret for telemetry packet signing (Layer 3 defense architecture)
TELEMETRY_HMAC_SECRET=change-me
